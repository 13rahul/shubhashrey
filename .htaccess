# Force UTF-8 so punctuation is not mis-decoded by the host / browser
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .htm .css .js .json .xml .txt .php
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=UTF-8"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Content-Type "application/javascript; charset=UTF-8"
  </FilesMatch>
</IfModule>

# Clean product URLs + legacy redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old: /product.html?id=e-6013  →  /products/e-6013
  RewriteCond %{QUERY_STRING} (^|&)id=([a-z0-9-]+)(&|$) [NC]
  RewriteRule ^product\.html$ /products/%2? [R=301,L]

  # Hide .html extension: /products/e-6013.html → /products/e-6013
  RewriteCond %{THE_REQUEST} \s/+products/([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^products/([a-z0-9-]+)\.html$ /products/$1 [R=301,L]

  # Serve clean URL: /products/e-6013 → products/e-6013.html
  RewriteRule ^products/([a-z0-9-]+)/?$ products/$1.html [L]
</IfModule>
